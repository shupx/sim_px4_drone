<?xml version="1.0"?>
<!-- For visualization in real experiments -->

<launch>
    <arg name="uav1_urdf_model_path" default="$(find px4_rotor_sim)/model/iris.urdf"/>
    <arg name="uav2_urdf_model_path" default="$(find px4_rotor_sim)/model/iris.urdf"/>
    <arg name="uav3_urdf_model_path" default="$(find px4_rotor_sim)/model/iris.urdf"/>
    <arg name="uav4_urdf_model_path" default="$(find px4_rotor_sim)/model/iris.urdf"/>
    <arg name="uav5_urdf_model_path" default="$(find px4_rotor_sim)/model/iris.urdf"/>
    <arg name="uav6_urdf_model_path" default="$(find px4_rotor_sim)/model/iris.urdf"/>
    <arg name="uav7_urdf_model_path" default="$(find px4_rotor_sim)/model/iris.urdf"/>
    <arg name="uav8_urdf_model_path" default="$(find px4_rotor_sim)/model/iris.urdf"/>
    <arg name="uav9_urdf_model_path" default="$(find px4_rotor_sim)/model/iris.urdf"/>
    <arg name="uav10_urdf_model_path" default="$(find px4_rotor_sim)/model/iris.urdf"/>

    <include file="$(find px4_rotor_sim)/launch/drone_visualizer_single.launch">
        <arg name="namespace" value="uav1"/>
        <arg name="open_rviz" value="false"/>
        <arg name="urdf_model_path" value="$(arg uav1_urdf_model_path)"/>
    </include>

    <include file="$(find px4_rotor_sim)/launch/drone_visualizer_single.launch">
        <arg name="namespace" value="uav2"/>
        <arg name="open_rviz" value="false"/>
        <arg name="urdf_model_path" value="$(arg uav2_urdf_model_path)"/>
    </include>

    <include file="$(find px4_rotor_sim)/launch/drone_visualizer_single.launch">
        <arg name="namespace" value="uav3"/>
        <arg name="open_rviz" value="false"/>
        <arg name="urdf_model_path" value="$(arg uav3_urdf_model_path)"/>
    </include>

    <include file="$(find px4_rotor_sim)/launch/drone_visualizer_single.launch">
        <arg name="namespace" value="uav4"/>
        <arg name="open_rviz" value="false"/>
        <arg name="urdf_model_path" value="$(arg uav4_urdf_model_path)"/>
    </include>

    <include file="$(find px4_rotor_sim)/launch/drone_visualizer_single.launch">
        <arg name="namespace" value="uav5"/>
        <arg name="open_rviz" value="false"/>
        <arg name="urdf_model_path" value="$(arg uav5_urdf_model_path)"/>
    </include>

    <include file="$(find px4_rotor_sim)/launch/drone_visualizer_single.launch">
        <arg name="namespace" value="uav6"/>
        <arg name="open_rviz" value="false"/>
        <arg name="urdf_model_path" value="$(arg uav6_urdf_model_path)"/>
    </include>

    <include file="$(find px4_rotor_sim)/launch/drone_visualizer_single.launch">
        <arg name="namespace" value="uav7"/>
        <arg name="open_rviz" value="false"/>
        <arg name="urdf_model_path" value="$(arg uav7_urdf_model_path)"/>
    </include>

    <include file="$(find px4_rotor_sim)/launch/drone_visualizer_single.launch">
        <arg name="namespace" value="uav8"/>
        <arg name="open_rviz" value="false"/>
        <arg name="urdf_model_path" value="$(arg uav8_urdf_model_path)"/>
    </include>

    <include file="$(find px4_rotor_sim)/launch/drone_visualizer_single.launch">
        <arg name="namespace" value="uav9"/>
        <arg name="open_rviz" value="false"/>
        <arg name="urdf_model_path" value="$(arg uav9_urdf_model_path)"/>
    </include>

    <include file="$(find px4_rotor_sim)/launch/drone_visualizer_single.launch">
        <arg name="namespace" value="uav10"/>
        <arg name="open_rviz" value="false"/>
        <arg name="urdf_model_path" value="$(arg uav10_urdf_model_path)"/>
    </include>

    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find px4_rotor_sim)/launch/rviz/multi_px4_rotor.rviz" required="true" />

</launch>
